# Bybit DEMO environment template. Copy to .env.local and fill in.
# See DEMO_SETUP.md. Never commit .env.local.
#
# NOTE: Bybit API key + secret are NOT here on purpose. Enter them in the
# terminal UI (Settings) so they are never in a file, a script, or shell history.

# REQUIRED. All /api/* routes reject requests without this token.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=""

# REQUIRED for anything long-running. Where db.json lives (settings, trades, paper state).
# Must point at PERSISTENT storage. On Cloud Run the container filesystem is wiped on
# every redeploy and scale-to-zero, silently taking your trade history with it.
DATA_DIR="./data"

# Server port (default 3000).
PORT="3000"

# Optional. Without it the MetaLabeler falls back to its local deterministic classifier.
GEMINI_API_KEY=""

# Only needed when switching back to MT5 for a prop firm. Shared secret with the
# MoebyBridge EA. Unused while activeBroker is 'bybit'.
MT5_BRIDGE_TOKEN=""

# Optional. Self-referential links / callbacks.
APP_URL=""
