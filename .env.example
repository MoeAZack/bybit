# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API_AUTH_TOKEN: password for the dashboard AND the bearer token for /api/* routes.
# This repo is public — NEVER commit a real value here. Generate one instead:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production it comes from Secret Manager (see deploy.sh), not from this file.
API_AUTH_TOKEN=""

# MT5_BRIDGE_TOKEN: shared secret between the server and the MoebyBridge EA.
# Same rule: generate per environment, never commit a real value.
MT5_BRIDGE_TOKEN=""
